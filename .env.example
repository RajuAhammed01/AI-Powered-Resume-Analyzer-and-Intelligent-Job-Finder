# Flask Application Secret Key
SECRET_KEY=your_secret_key_here

# Database URI (Leave empty for local SQLite, or provide PostgreSQL URI for Vercel/Supabase/Neon)
DATABASE_URL=postgresql://user:password@host:port/database

# Optional live job API credentials
JSEARCH_API_KEY=your_jsearch_api_key_here
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Enable SentenceTransformer locally (false by default for lightweight serverless)
ENABLE_HEAVY_TRANSFORMERS=false
